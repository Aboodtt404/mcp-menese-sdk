              "conditionType": {
                "type": "string",
                "enum": [
                  "price_above",
                  "price_below"
                ],
                "description": "Condition type (for conditional jobs)"
              },
              "conditionToken": {
                "type": "string",
                "description": "Token to monitor price of"
              },
              "conditionThreshold": {
                "type": "string",
                "description": "Price threshold in USD (e.g. '50000')"
              },
              "checkIntervalSeconds": {
                "type": "number",
                "minimum": 60,
                "description": "How often to check condition (seconds)"
              },
              "allowFundMovement": {
                "type": "boolean",
                "description": "Allow job to move funds (required for swaps, default false)"
