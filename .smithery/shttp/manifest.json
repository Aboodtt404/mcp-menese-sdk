              "intervalSeconds": {
                "type": "number",
                "minimum": 60,
                "description": "Interval for recurring jobs (seconds, min 60)"
              },
              "chain": {
                "type": "string",
                "enum": [
                  "ethereum",
                  "polygon",
                  "arbitrum",
                  "base",
                  "optimism",
                  "bnb",
                  "solana",
                  "bitcoin",
                  "litecoin",
                  "icp",
                  "sui",
                  "ton",
                  "xrp",
                  "cardano",
                  "tron",
                  "aptos",
                  "near",
                  "cloakcoin",
                  "thorchain"
